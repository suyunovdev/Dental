# Muhit va port
NODE_ENV=development
PORT=3000

# Baza (PostgreSQL 17)
DATABASE_URL=postgresql://f2:f2@localhost:5432/f2

# Auth va xavfsizlik (JWT_ACCESS_SECRET kamida 32 belgi)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
COOKIE_SECURE=false

# Fayllar
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Klinika ma'lumotlari
CLINIC_NAME=
CLINIC_PHONE=
CLINIC_TIMEZONE=Asia/Tashkent
CASHIER_MAX_DISCOUNT_PERCENT=10

# Integratsiyalar (bo'sh bo'lsa o'chiq)
TELEGRAM_BOT_TOKEN=

# Dastlabki ma'lumotlar (faqat seed uchun)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Qo'shimcha
CORS_ORIGIN=http://localhost:5173
GIT_SHA=dev
